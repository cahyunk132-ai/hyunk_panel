# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# ── Enkripsi token Wings (AES-256-GCM) ───────────────────────────────
# Generate dengan: openssl rand -hex 32
WINGS_TOKEN_ENCRYPTION_KEY=xxxx

# ── Bootstrap seed (WAJIB diisi hanya saat menjalankan /api/admin/seed) ─
# Token Wings asli untuk node existing (dari /etc/pterodactyl/config.yml di node,
# field "token"). Tidak boleh di-commit. Dipakai sekali untuk mengenkripsi +
# menyimpan token node ke database. Boleh dikosongkan setelah seed sukses.
WINGS_SEED_NODE_TOKEN=

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://panel.wangstore.web.id
