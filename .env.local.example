# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_ROLE_KEY=xxxx

# ── Enkripsi token Wings (AES-256-GCM) ───────────────────────────────
# Generate dengan: openssl rand -hex 32
WINGS_TOKEN_ENCRYPTION_KEY=xxxx

# ── Bootstrap seed (WAJIB diisi hanya saat menjalankan /api/admin/seed) ─
# Token Wings asli untuk node existing (dari /etc/pterodactyl/config.yml di node,
# field "token"). Tidak boleh di-commit. Dipakai sekali untuk mengenkripsi +
# menyimpan token node ke database. Boleh dikosongkan setelah seed sukses.
WINGS_SEED_NODE_TOKEN=

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://panel.wangstore.web.id

# ── Auto Backup: OAuth cloud storage ─────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/storage/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dropbox App Console → app → Settings. Redirect URI:
# {NEXT_PUBLIC_APP_URL}/api/auth/storage/callback/dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# OneDrive: placeholder (UI sudah ada, tombol disabled sampai kredensial tersedia)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ── Auto Backup: enkripsi & cron ─────────────────────────────────────
# Key enkripsi kredensial cloud storage (AES-256-GCM). Generate: openssl rand -hex 32
STORAGE_TOKEN_ENCRYPTION_KEY=xxxx
# Secret untuk Vercel Cron (dikirim sebagai Authorization: Bearer). Generate: openssl rand -hex 32
CRON_SECRET=xxxx
