# ── admin_gabut · AI Minecraft bot ──────────────────────────────────────────
# Salin file ini menjadi `mcbot/.env` (opsional — semua bisa juga lewat CLI flag).

# ── Target server Minecraft ──────────────────────────────────────────────────
# Server cracked/offline  → auth offline (default)
# Server premium          → MC_AUTH=microsoft + MC_PASSWORD / device-code login
MC_SERVER=127.0.0.1:25565
MC_USERNAME=admin_gabut
MC_AUTH=offline
# MC_VERSION=1.21.4         # kosongkan untuk auto-detect dari ping server
# MC_PASSWORD=

# ── Otak (brain) ─────────────────────────────────────────────────────────────
# groq      → pakai Groq API (butuh GROQ_API_KEY)
# heuristic → rule-based, jalan tanpa API key & tanpa internet (buat debugging)
BRAIN=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Model Groq (OpenAI-compatible). Cek daftar terbaru: GET https://api.groq.com/openai/v1/models
# Contoh model produksi: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
# Arahkan ke proxy/mock lain bila perlu (harus kompatibel OpenAI chat completions):
# GROQ_BASE_URL=http://127.0.0.1:8787/openai/v1
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=400
GROQ_TIMEOUT_MS=10000
GROQ_RETRIES=2
# Kalau Groq error/timeout/JSON rusak → pakai heuristic (biar bot tidak beku)
BRAIN_FALLBACK_HEURISTIC=true

# ── Loop OODA ────────────────────────────────────────────────────────────────
LOOP_INTERVAL_MS=2000
LOOP_URGENT_MS=400
ACTION_TIMEOUT_MS=12000
# auto | mine | farm | fight | survive | explore
TASK=auto
# Objective yang dikejar saat TASK=auto (JSON). Default:
# OBJECTIVES=[{"kind":"mine","target":"coal_ore","count":8},{"kind":"mine","target":"iron_ore","count":6},{"kind":"farm","count":8},{"kind":"explore","count":2}]

# ── Penglihatan / scan blok ──────────────────────────────────────────────────
ENTITY_RADIUS=16
BLOCK_RADIUS=20
BLOCK_Y_BELOW=12
BLOCK_Y_ABOVE=4
MAX_BLOCK_RESULTS=40
SCAN_CACHE_MS=1200

# ── Keselamatan ──────────────────────────────────────────────────────────────
SAFE_FLEE_HP_PCT=0.3
SAFE_LOW_HP_PCT=0.5
SAFE_LOW_FOOD=14
SAFE_HOSTILE_RADIUS=10
SAFE_CREEPER_RADIUS=3

# ── Pathfinder ───────────────────────────────────────────────────────────────
# boleh menggali kalau itu satu-satunya jalan ke target (bot tambang)
PATHFINDER_CAN_DIG=true
PATHFINDER_PARKOUR=true

# ── Lain-lain ────────────────────────────────────────────────────────────────
# PVP_MODE=1              # perlakukan pemain lain sebagai ancaman (server anarki)
# TRACE_FILE=logs/trace.jsonl
# DRY_RUN=1               # hanya observe+decide, aksi tidak dijalankan
# VERBOSE=1

# ── Dev server lokal (cracked/offline) ───────────────────────────────────────
DEV_PORT=25565
DEV_SEED=20261013
DEV_VERSION=1.21.4
DEV_DAMAGE=2
# DEV_AUTO_MOB_MS=60000   # spawn zombie otomatis tiap 60s
# DEV_KIT_ON_JOIN=1
DASH_PORT=8090
